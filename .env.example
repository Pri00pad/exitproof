# Copy to .env.local and fill in from Supabase Dashboard → Project Settings → API Keys.
# Never commit .env.local.

# Public (safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable key (sb_publishable_...) or legacy anon key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only — NEVER prefix with NEXT_PUBLIC_. Used only by /verify (HR) server code and scripts.
# Secret key (sb_secret_...) or legacy service_role key
SUPABASE_SECRET_KEY=

# Absolute origin used to build HR verification links.
# Local: http://localhost:3000 — Vercel: https://<your-app>.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local scripts only (Phase 4 demo seed). The demo password is never stored here or in code.
DEMO_EMAIL=
